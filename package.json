{
  "name": "rg-generator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-templates.mjs && next dev --port 5173",
    "build": "node scripts/generate-templates.mjs && next build",
    "lint": "oxlint",
    "preview": "next start --port 5173",
    "test": "node scripts/generate-templates.mjs && vitest run",
    "test:watch": "node scripts/generate-templates.mjs && vitest",
    "start": "next start --port 5173",
    "typecheck": "node scripts/generate-templates.mjs && tsc --noEmit"
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
